NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-domain.example
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zelon_api
MYSQL_USER=zelon_api
MYSQL_PASSWORD=
# Enable for a public TLS-enabled MySQL service using a trusted CA
MYSQL_SSL=false
# 32 random bytes, base64 encoded; preserve across redeploys
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional, default 1. Use only behind a trusted Hostinger reverse proxy.
TRUST_PROXY=1
# Optional upload size cap in MiB, 1-256 (default 100)
MAX_MEDIA_MB=100
# Docker Compose only; never commit a real password
MYSQL_ROOT_PASSWORD=
