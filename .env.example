NODE_ENV=production
APP_ORIGIN=https://CHANGE_ME_DOMAIN
# SQLite: no external database required. Overrides any old MYSQL_HOST value.
DATABASE_DRIVER=sqlite
# On recognized Hostinger paths the app selects the domain's private zelon-data folder.
# Otherwise set an absolute persistent private path outside app/public_html/hbuilds.
DATA_DIR=
# Keep the same 32-byte base64 encryption key across updates.
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRUST_PROXY=1
MAX_MEDIA_MB=100

# Optional MySQL mode: set DATABASE_DRIVER=mysql and these values.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
# Docker MySQL mode only
MYSQL_ROOT_PASSWORD=
